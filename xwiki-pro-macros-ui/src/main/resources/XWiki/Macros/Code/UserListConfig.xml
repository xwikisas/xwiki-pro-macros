  <content>= {{translation key="userlist.config.heading"/}} =

----

{{velocity}}
#set ($discard = $xwiki.ssx.use('XWiki.Macros.Code.UserListConfig'))
#set ($discard = $xwiki.jsx.use('XWiki.Macros.Code.UserListConfig'))
#set ($configDoc = $xwiki.getDocument('XWiki.Macros.Code.UserListConfig'))
#set ($className = 'XWiki.Macros.Code.UserListConfigClass')
#set ($classBDoc = $xwiki.getDocument('XWiki.XWikiUsers'))
#set ($targetClass = $classBDoc.xWikiClass)
#set ($obj = $configDoc.getObject($className, true))
#set ($propName = 'bannedFields')
#set ($inputName = "${className}_0_${propName}")
#set ($inputId = "${configDoc.fullName}_${inputName}")
#set ($currentValues = $obj.getProperty($propName).list)
#set ($selectedValues = $obj.getProperty($propName).getValue())
#set ($fieldLabel = $services.localization.render('userlist.config.bannedFields.label'))
#set ($fieldDescription = $services.localization.render('userlist.config.bannedFields.label.description'))
#set ($saveLabel = $services.localization.render('userlist.config.save.button'))

{{html}}
  &lt;form id="userlist_$escapetool.xml($configDoc.fullName)" method="post" action="$doc.getURL('save')" class="xform"&gt;
    &lt;fieldset&gt;
      &lt;dl&gt;
      &lt;dt&gt;
        &lt;label for="$inputId"&gt;$escapetool.xml($fieldLabel)&lt;/label&gt;&lt;/dt&gt;
        &lt;span class="xHint"&gt;$escapetool.xml($fieldDescription)&lt;/span&gt;
      &lt;dd&gt;
        #template("html_displayer/userlistproperties/edit.vm")
        &lt;input name="$inputName" type="hidden" value="$selectedValues"&gt;
      &lt;/dd&gt;
      &lt;/dl&gt;
      &lt;input
        type="hidden"
        id="$escapetool.xml($configDoc.fullName)_redirect"
        name="xredirect"
        value="$escapetool.xml($xwiki.relativeRequestURL)"&gt;
      &lt;input type="hidden" name="form_token" value="$escapetool.xml($services.csrf.token)"&gt;
      &lt;div class="buttons"&gt;
        &lt;span class="buttonwrapper"&gt;
          &lt;input type="submit" value="$escapetool.xml($saveLabel)" class="button" name="action_save"&gt;
        &lt;/span&gt;
      &lt;/div&gt;
    &lt;/fieldset&gt;
  &lt;/form&gt;
{{/html}}
{{/velocity}}</content>
