    <property>
      <code>require(['jquery'], function ($) {
  const SEPARATOR = ',';

  $(document).ready(function () {
    let select = $('select.xwiki-selectize');
    let hidden = select.closest('dd')
      .find('input[type="hidden"][name$="_bannedFields"]');

    select.on('change', function () {
      let instance = select[0].selectize;
      if (!instance) {
        return;
      }
      let values = instance.getValue();
      hidden.val(Array.isArray(values) ? values.join(SEPARATOR) : values);
    });
  });
});</code>
